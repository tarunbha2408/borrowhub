# ============================================================================
#  BorrowHub - PRODUCTION / PUBLIC DEMO environment
#  Copy these keys into the "Environment Variables" section of your PaaS dashboard.
#  (This file is committed to the repository, so it must never hold real secrets.)
# ============================================================================

# --- Core -------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
# The platform provides PORT; Render/Railway inject it automatically.

# --- Database (managed MySQL - Aiven / Railway / PlanetScale / RDS) ---------
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME?charset=utf8mb4
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/defaultdb?charset=utf8mb4

# --- Security ---------------------------------------------------------------
# 48+ random characters. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Public demo behaviour --------------------------------------------------
# true = demo mode: payments are always simulated, OTP codes are returned to the
#        browser, and the scheduled reset endpoint is available.
DEMO_MODE=true
# Strong random token required by POST /api/internal/reset-demo.
# Leave empty to disable the reset endpoint entirely.
DEMO_RESET_TOKEN=

# --- CORS -------------------------------------------------------------------
# JSON list - your own domain only.
CORS_ORIGINS=["https://your-app.onrender.com"]

# --- Payments ---------------------------------------------------------------
# Leave empty for a demo (simulated checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_SIMULATED=True

# --- Uploads ----------------------------------------------------------------
# PaaS filesystems are ephemeral: either configure Cloudinary or mount a disk.
# A Render disk mounted at /var/data means UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR=/var/data/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ------------------------------------------------------------------
# Leave empty for the demo: the OTP is shown in the browser instead.
SMTP_USER=
SMTP_PASSWORD=
