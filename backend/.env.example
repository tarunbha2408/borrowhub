# BorrowHub environment configuration
# Copy to backend/.env and fill in your own values. Never commit backend/.env.

PROJECT_NAME="BorrowHub"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# --- Database ---------------------------------------------------------------
# The schema, triggers, routines and views are created by database/schema.sql.
# !! EDIT THE PASSWORD: 12345 is only a placeholder. It must match the password
# of your own MySQL/MariaDB root user, otherwise every database call fails with
# "Access denied". Special characters must be URL-encoded (@ -> %40, # -> %23).
DATABASE_URL="mysql+pymysql://root:12345@localhost:3306/borrowhub?charset=utf8mb4"
# Leave AUTO_CREATE_TABLES off: schema.sql owns the schema.
AUTO_CREATE_TABLES=False

# --- Security ---------------------------------------------------------------
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRY_MINUTES=15
MAX_OTP_ATTEMPTS=5

# Comma separated list of accounts that are promoted to ADMIN on sign-in.
# ADMIN_EMAILS=["admin@svnit.ac.in"]

# --- Razorpay (optional) ----------------------------------------------------
# Leave empty to run the checkout in simulated mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENTS_SIMULATED=True

# --- Cloudinary (optional) --------------------------------------------------
# Leave empty to store uploads on local disk under backend/static/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- SMTP (optional) --------------------------------------------------------
# Leave empty and verification codes are printed to the server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@borrowhub.local"
SMTP_FROM_NAME="BorrowHub SVNIT"
SMTP_TLS=True

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","http://127.0.0.1:3000"]
